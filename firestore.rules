rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      match /conversations/{conversationId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(conversationId);
        allow delete: if isOwner(userId);
      }

      match /chat_sessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(sessionId);
        allow delete: if isOwner(userId);
      }

      match /transcripts/{transcriptId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(transcriptId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
